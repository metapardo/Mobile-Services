      "sidebarAccentForeground": { "$value": "#0A3152" },
      "sidebarRing": { "$value": "#078FEA" }
    },
    "dark": {
      "background": { "$value": "#03111F" },
      "foreground": { "$value": "#F3F8FC" },
      "border": { "$value": "#1B3E5C" },
